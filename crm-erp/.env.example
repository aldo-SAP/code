# Copy to .env.local for local work. Never commit real values.
# Local development needs NONE of these: without DATABASE_URL the app uses an embedded Postgres in data/pgdata.

# --- Production (set in the Render dashboard) ---
APP_URL=https://crm.yourcompany.com
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
APP_SECRET=long-random-string
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=you@yourcompany.com
BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_ADMIN_PASSWORD=   (optional; leave out to sign in with Microsoft only)

# --- Optional ---
# DATABASE_POOL=8        connections per app instance
# DATABASE_SSL=off       only for a local Postgres without SSL
# INSECURE_COOKIES=1     only to run `npm start` over plain http locally
